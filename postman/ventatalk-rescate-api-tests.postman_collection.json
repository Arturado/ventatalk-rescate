              { "key": "x-api-key", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descripcion\": \"Editado por Postman {{run_id}}\",\n  \"contextura\": \"media\"\n}"
            },
            "url": "{{base_url}}/api/personas/{{persona_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const responseJson = pm.response.json();",
                  "pm.test('persiste cambios', () => {",
                  "  pm.expect(responseJson.contextura).to.eql('media');",
                  "  pm.expect(responseJson.descripcion).to.include(pm.collectionVariables.get('run_id'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cambiar estado de persona",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"en_proceso\",\n  \"descripcion_cambio\": \"Prueba automatizada\"\n}"
            },
            "url": "{{base_url}}/api/personas/{{persona_id}}/estado"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('actualiza el estado', () => pm.expect(pm.response.json().estado).to.eql('en_proceso'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar persona de prueba",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "x-api-key", "value": "{{api_key}}" }
            ],
            "url": "{{base_url}}/api/personas/{{persona_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('confirma eliminacion', () => pm.expect(pm.response.json().ok).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirmar persona eliminada",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-api-key", "value": "{{api_key}}" }
            ],
            "url": "{{base_url}}/api/personas/{{persona_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('ya no existe', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
