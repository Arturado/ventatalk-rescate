    {
      "name": "05 - Yo te ayudo V2 protegido",
      "item": [
        {
          "name": "Rechaza listado V2 sin API key",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v2/casos-ayuda"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rechaza actor V2 sin firma HMAC",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-api-key", "value": "{{api_key}}" }
            ],
            "url": "{{base_url}}/api/v2/casos-ayuda?organizacion_id={{v2_organization_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 401', () => pm.response.to.have.status(401));",
                  "pm.test('no permite omitir firma', () => pm.expect(['API Key inválida', 'Falta la firma de organización del actor']).to.include(pm.response.json().detail))"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar V2 con actor HMAC",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-api-key", "value": "{{api_key}}" },
              { "key": "x-actor-org-id", "value": "{{v2_organization_id}}" },
              { "key": "x-actor-role", "value": "{{v2_actor_role}}" },
              { "key": "x-actor-email", "value": "{{v2_actor_email}}" },
              { "key": "x-actor-uid", "value": "" },
              { "key": "x-actor-ip-hash", "value": "" },
              { "key": "x-actor-org-timestamp", "value": "{{v2_actor_timestamp}}" },
              { "key": "x-actor-org-signature", "value": "{{v2_actor_signature}}" }
            ],
            "url": "{{base_url}}/api/v2/casos-ayuda?organizacion_id={{v2_organization_id}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "const organization = pm.variables.replaceIn('{{v2_organization_id}}');",
                  "const role = pm.variables.replaceIn('{{v2_actor_role}}');",
                  "const email = pm.variables.replaceIn('{{v2_actor_email}}').toLowerCase();",
                  "const secret = pm.variables.replaceIn('{{actor_signing_secret}}');",
                  "if (!secret) { pm.execution.skipRequest(); return; }",
                  "const message = `${organization}|${role}|${email}|||${timestamp}`;",
                  "pm.collectionVariables.set('v2_actor_timestamp', timestamp);",
                  "pm.collectionVariables.set('v2_actor_signature', CryptoJS.HmacSHA256(message, secret).toString(CryptoJS.enc.Hex));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('devuelve lista V2', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        }
      ]
    }
