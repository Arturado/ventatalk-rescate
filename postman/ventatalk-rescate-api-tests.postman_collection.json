{
  "info": {
    "_postman_id": "729d9b89-f095-49ae-8709-1784d7feb138",
    "name": "Ventatalk Rescate - API tests automatizados",
    "description": "Pruebas de integracion repetibles para salud, autenticacion, personas, hospitales/pacientes y casos de ayuda. Ejecutar la coleccion completa en orden contra una instancia local o de pruebas. Los datos creados se eliminan al final de cada flujo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === 'Health' || pm.info.requestName === 'Crear caso de ayuda') {",
          "  const runId = pm.variables.replaceIn('{{$guid}}');",
          "  pm.collectionVariables.set('run_id', runId);",
          "  pm.collectionVariables.set('test_cedula', String(Date.now()).slice(-8));",
          "  const keys = pm.info.requestName === 'Health' ? ['persona_id', 'hospital_id', 'paciente_id', 'caso_id'] : ['caso_id'];",
          "  keys.forEach((key) => pm.collectionVariables.unset(key));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Salud y autenticacion",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const responseJson = pm.response.json();",
                  "pm.test('servicio saludable', () => {",
                  "  pm.expect(responseJson.status).to.eql('ok');",
                  "  pm.expect(responseJson.service).to.eql('ventatalk-rescate');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Rechaza request sin API key",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/personas/count"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 401', () => pm.response.to.have.status(401));",
                  "pm.test('no filtra datos protegidos', () => pm.expect(pm.response.json().detail).to.eql('API Key inválida'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Acepta API key valida",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-api-key", "value": "{{api_key}}" }
            ],
            "url": "{{base_url}}/api/personas/count"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('total numerico', () => pm.expect(pm.response.json().total).to.be.a('number'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Personas",
      "item": [
        {
          "name": "Crear reporte de persona",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "nombres_apellidos", "value": "Persona Postman {{run_id}}", "type": "text" },
                { "key": "cedula", "value": "{{test_cedula}}", "type": "text" },
                { "key": "ultima_ubicacion", "value": "Zona prueba {{run_id}}", "type": "text" },
                { "key": "descripcion", "value": "Creado por pruebas Postman", "type": "text" },
                { "key": "numero_contacto", "value": "04121234567", "type": "text" },
                { "key": "tipo_reporte", "value": "desaparecido", "type": "text" },
                { "key": "tipo_reportante", "value": "integracion", "type": "text" },
                { "key": "sexo", "value": "no_determinado", "type": "text" },
                { "key": "edad_aproximada", "value": "adulto", "type": "text" },
                { "key": "sin_documentos", "value": "false", "type": "text" }
              ]
            },
            "url": "{{base_url}}/api/reportes/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('crea la persona', () => pm.response.to.have.status(201));",
                  "const responseJson = pm.response.json();",
                  "pm.collectionVariables.set('persona_id', responseJson.id);",
                  "pm.test('aplica valores iniciales', () => {",
                  "  pm.expect(responseJson.id).to.be.a('number');",
                  "  pm.expect(responseJson.estado).to.eql('desaparecido');",
                  "  pm.expect(responseJson.nombres_apellidos).to.include(pm.collectionVariables.get('run_id'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Buscar persona publicamente",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/buscar?nombre={{run_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const responseJson = pm.response.json();",
                  "pm.test('encuentra solo datos del flujo', () => {",
                  "  pm.expect(responseJson).to.be.an('array');",
                  "  pm.expect(responseJson.some((item) => item.id === Number(pm.collectionVariables.get('persona_id')))).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar persona protegida",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-api-key", "value": "{{api_key}}" }
            ],
            "url": "{{base_url}}/api/personas/{{persona_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const responseJson = pm.response.json();",
                  "pm.test('devuelve la persona creada', () => {",
                  "  pm.expect(responseJson.id).to.eql(Number(pm.collectionVariables.get('persona_id')));",
                  "  pm.expect(responseJson.created_at).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Editar persona",
          "request": {
            "method": "PATCH",
