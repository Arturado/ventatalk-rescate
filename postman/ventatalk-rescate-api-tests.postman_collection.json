    {
      "name": "03 - Casos de ayuda",
      "item": [
        {
          "name": "Crear caso de ayuda",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-api-key", "value": "{{api_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cedula\": \"{{test_cedula}}\",\n  \"nombre\": \"Caso Postman {{run_id}}\",\n  \"relato\": \"Relato automatizado {{run_id}}\",\n  \"condicion_resumen\": \"Condicion de prueba\",\n  \"monto_necesario\": 25.5,\n  \"moneda\": \"USD\",\n  \"consentimiento_publicacion\": true,\n  \"creado_por\": \"postman@example.test\",\n  \"contacto\": {\n    \"telefono\": \"04121234567\",\n    \"metodo_pago\": \"Transferencia\",\n    \"datos_pago\": \"Datos {{run_id}}\",\n    \"contacto_alterno\": \"postman@example.test\"\n  }\n}"
            },
            "url": "{{base_url}}/api/casos-ayuda/"
          },
          "event": [
