          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (Array.isArray(data) && data.length > 0) {",
                  "  pm.collectionVariables.set('solicitud_id', data[0].id);",
                  "}",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
