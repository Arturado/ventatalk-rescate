API_KEY=your_secret_api_key_here
ACTOR_SIGNING_SECRET=your_actor_signing_secret_here
BASE_URL=https://rescate.ventatalk.com
DATABASE_URL=sqlite:///./rescate.db
SECRET_KEY=your_very_secret_key_here
ADMIN_1_USER=admin1
ADMIN_1_PASS=pass1
ADMIN_2_USER=admin2
ADMIN_2_PASS=pass2

# Yo te ayudo V2: mantener apagado hasta completar el rollout y definir el piloto.
HELP_CASES_V2_ENABLED=false
HELP_CASES_V2_PILOT_ORGANIZATION_IDS=
HELP_DATA_ENCRYPTION_KEY_V1=base64_32_byte_key_here
HELP_DATA_ACTIVE_KEY_VERSION=v1
HELP_IDENTITY_HASH_KEY=independent_base64_32_byte_key_here
HELP_PRIVATE_UPLOAD_ROOT=uploads
HELP_FRONTEND_BASE_URL=https://your-production-host.example
HELP_ADMIN_NOTIFICATION_EMAILS=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Límites opcionales; los valores mostrados son los defaults validados.
DONOR_ACCOUNT_ACTOR_LIMIT=10
DONOR_ACCOUNT_IP_LIMIT=30
DONOR_ACCOUNT_LIMIT_WINDOW_SECONDS=300
DONOR_REPORT_LIMIT=20
DONOR_REPORT_LIMIT_WINDOW_SECONDS=3600
